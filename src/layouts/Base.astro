---
import '../styles/brand.css';
import '../styles/global.css';
import { withBase } from '../lib/url';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  /** schema.org objects that are true for this page (WebApplication, FAQPage, ...) */
  jsonLd?: Record<string, unknown>[];
}

const { title, description, noindex = false, jsonLd = [] } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
// Cloudflare Web Analytics is cookie-free; it only loads when the token is set at build time.
const beaconToken = import.meta.env.PUBLIC_CF_BEACON_TOKEN;

const nav = [
  { href: '/', label: 'Konverter' },
  { href: '/datev-zahlungsdatenservice-amazon-alternative/', label: 'Umstieg' },
  { href: '/amazon-gebuehren-buchen-datev/', label: 'Kontierung' },
  { href: '/steuerkanzlei/', label: 'Für Kanzleien' },
  { href: '/preise/', label: 'Preise' },
];
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title.endsWith("· Grünband") ? title : `${title} · Grünband`}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {jsonLd.map((obj) => (
      <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', ...obj })} />
    ))}
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <meta name="theme-color" content="#f6f3ea" />
    {beaconToken && (
      <script
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: beaconToken })}
      ></script>
    )}
  </head>
  <body>
    <div class="paper">
      <div class="wrap">
        <header class="site-head">
          <a class="brand" href={withBase('/')}>
            <img class="brand-mark" src={withBase('/brand/logo.svg')} alt="" width="32" height="32" />
            <span class="brand-name">Grünband</span>
            <span class="brand-desc">Amazon-Abrechnung → DATEV</span>
          </a>
          <nav class="site-nav" aria-label="Hauptnavigation">
            <ul>
              {nav.map((item) => (
                <li>
                  <a href={withBase(item.href)}>{item.label}</a>
                </li>
              ))}
            </ul>
          </nav>
        </header>

        <main id="inhalt">
          <slot />
        </main>

        <footer class="site-foot">
          <p class="disclaimer">
            Nicht mit Amazon oder DATEV verbunden. Amazon und DATEV sind Marken ihrer jeweiligen Inhaber.
          </p>
          <ul class="legal">
            <li><a href={withBase('/impressum/')}>Impressum</a></li>
            <li><a href={withBase('/datenschutz/')}>Datenschutz</a></li>
            <li><a href={withBase('/agb/')}>AGB</a></li>
          </ul>
        </footer>
      </div>
    </div>
  </body>
</html>

<style>
  .site-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: calc(2 * var(--u));
    padding: calc(3 * var(--u)) 0 calc(2 * var(--u));
    border-bottom: var(--rule-heavy);
  }
  .site-nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: calc(1 * var(--u)) calc(3 * var(--u));
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: var(--fs-sm);
  }
  main {
    padding: calc(4 * var(--u)) 0 calc(8 * var(--u));
  }
  .site-foot {
    border-top: var(--rule-heavy);
    padding: calc(2 * var(--u)) 0 calc(6 * var(--u));
    font-size: var(--fs-xs);
    color: var(--ink-muted);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: calc(2 * var(--u));
  }
  .site-foot p {
    margin: 0;
  }
  .legal {
    display: flex;
    gap: calc(3 * var(--u));
    list-style: none;
    margin: 0;
    padding: 0;
  }
</style>
