# Names only. Never commit values. Payments stay in Stripe TEST mode until the owner goes live.

# Build time (static site)
SITE_URL=
SITE_BASE=
# Cloudflare Web Analytics (cookie-free). Leave empty to disable analytics.
PUBLIC_CF_BEACON_TOKEN=

# Cloudflare Pages Functions (server side, set in the Pages project settings)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_HAENDLER_MONTH=
STRIPE_PRICE_HAENDLER_YEAR=
STRIPE_PRICE_KANZLEI_MONTH=
STRIPE_PRICE_KANZLEI_YEAR=
# KV namespace binding name used by functions/: LICENCES (configured in wrangler.toml / Pages settings)
