---
import Base from '../layouts/Base.astro';
import Converter from '../components/tool/Converter';
import { withBase } from '../lib/url';
---

<Base
  title="Amazon-Abrechnung in DATEV-Buchungsstapel umwandeln"
  description="Amazon-Abrechnungsbericht (Flat File V2) im Browser prüfen und als DATEV-Buchungsstapel (EXTF) exportieren. Die Datei wird nicht hochgeladen."
  jsonLd={[
    {
      '@type': 'WebApplication',
      name: 'Grünband – Amazon-Abrechnung zu DATEV',
      applicationCategory: 'BusinessApplication',
      operatingSystem: 'Browser',
      inLanguage: 'de',
      description:
        'Wandelt den Amazon-Abrechnungsbericht (Flat File V2) im Browser in einen DATEV-Buchungsstapel (EXTF) um, mit Abgleich gegen die Auszahlung.',
      offers: [
        { '@type': 'Offer', name: 'Prüfung und Vorschau', price: '0', priceCurrency: 'EUR' },
        { '@type': 'Offer', name: 'Händler, monatlich (netto)', price: '9', priceCurrency: 'EUR' },
        { '@type': 'Offer', name: 'Kanzlei, monatlich (netto)', price: '29', priceCurrency: 'EUR' },
      ],
    },
  ]}
>
  <section class="intro">
    <div class="intro-text">
      <p class="eyebrow">Flat File V2 → DATEV EXTF · im Browser</p>
      <h1>Amazon-Abrechnung in DATEV-Buchungen umwandeln</h1>
      <p class="lead">
        Legen Sie den Abrechnungsbericht ab: Sie sehen sofort, ob die Zeilen zur Auszahlung passen, und erhalten einen geprüften Buchungsstapel für DATEV.
      </p>
    </div>
    <figure class="intro-art">
      <img src={withBase('/art/hero.svg')} alt="" width="490" height="294" />
    </figure>
  </section>
  <Converter client:load />

  <hr class="rule-heavy" />
  <p class="section-label">04 Ablauf</p>
  <div class="grid">
    <div class="col-main">
      <figure class="art-mobile"><img src={withBase('/art/hero.svg')} alt="" width="490" height="294" /></figure>
      <h2>So arbeitet der Konverter</h2>
      <ol class="steps">
        <li class="step">
          <img src={withBase('/art/spot-1.svg')} alt="" width="480" height="360" />
          <p class="section-label">01</p>
          <h3>Datei ablegen</h3>
          <p>Den Abrechnungsbericht (Flat File V2) aus dem Seller Central laden und oben ablegen. Er wird nur in Ihrem Browser gelesen.</p>
        </li>
        <li class="step">
          <img src={withBase('/art/spot-2.svg')} alt="" width="480" height="360" />
          <p class="section-label">02</p>
          <h3>Abgleich prüfen</h3>
          <p>Die Summe aller Zeilen wird mit der Auszahlung verglichen. Bei einer Differenz bleibt der Export gesperrt.</p>
        </li>
        <li class="step">
          <img src={withBase('/art/spot-3.svg')} alt="" width="480" height="360" />
          <p class="section-label">03</p>
          <h3>Stapel einlesen</h3>
          <p>Die EXTF-Datei in DATEV einlesen. Die Konten legen Sie oder Ihre Steuerkanzlei vorher fest.</p>
        </li>
      </ol>

      <h2>Was in den Buchungsstapel kommt</h2>
      <table class="ledger">
        <thead>
          <tr><th>Buchung</th><th>Konto</th><th>Gegenkonto</th><th>Belegfeld 1</th></tr>
        </thead>
        <tbody>
          <tr><td>Umsätze, Versand, Rabatte</td><td>Verrechnungskonto</td><td>Sammeldebitor</td><td>Bestellnummer</td></tr>
          <tr><td>Gebühren</td><td>Verrechnungskonto</td><td>Aufwandskonto</td><td>Bestellnummer oder Abrechnungsnummer</td></tr>
          <tr><td>Reserve</td><td>Verrechnungskonto</td><td>Reservekonto</td><td>Abrechnungsnummer</td></tr>
          <tr><td>Auszahlung</td><td>Verrechnungskonto</td><td>Geldtransit</td><td>Abrechnungsnummer</td></tr>
          <tr><td>Differenz (nur auf Wunsch)</td><td>Verrechnungskonto</td><td>Differenzkonto</td><td>Abrechnungsnummer</td></tr>
        </tbody>
      </table>

      <h2>Häufige Fragen</h2>
      <details class="faq">
        <summary>Wird meine Datei hochgeladen?</summary>
        <p>Nein. Die Datei wird im Browser gelesen. Beim Download gehen nur Lizenzschlüssel und ein Hash aus Berater- und Mandantennummer an den Server.</p>
      </details>
      <details class="faq">
        <summary>Welche Berichte werden gelesen?</summary>
        <p>Der Abrechnungsbericht im Format Flat File V2 in EUR. Den alten Bericht (V1, XML) liefert Amazon seit dem 11.11.2026 nicht mehr; der Konverter weist ihn zurück.</p>
      </details>
      <details class="faq">
        <summary>Was passiert bei einer Differenz?</summary>
        <p>Der Export bleibt gesperrt. Wenn Sie bewusst »Trotzdem exportieren« wählen, entsteht genau eine Differenzbuchung auf das von Ihnen genannte Konto.</p>
      </details>
      <details class="faq">
        <summary>Wer legt die Konten fest?</summary>
        <p>Sie oder Ihre Steuerkanzlei. Vorschläge sind keine Buchungsempfehlung, und die Bestätigung der Abstimmung ist vor dem ersten Download Pflicht.</p>
      </details>
      <details class="faq">
        <summary>Was kostet der Download?</summary>
        <p>Händler 9 € im Monat oder 89 € im Jahr, Kanzlei 29 € im Monat oder 290 € im Jahr, netto. Details auf der <a href={withBase('/preise/')}>Preisseite</a>.</p>
      </details>
    </div>
    <aside class="col-side">
      <p class="label">Weiterlesen</p>
      <ul>
        <li><a href={withBase('/datev-zahlungsdatenservice-amazon-alternative/')}>Ende des DATEV Zahlungsdatenservice für Amazon</a></li>
        <li><a href={withBase('/amazon-abrechnungsbericht-flat-file-v2/')}>Abrechnungsbericht Flat File V2</a></li>
        <li><a href={withBase('/amazon-gebuehren-buchen-datev/')}>Amazon-Gebühren buchen</a></li>
        <li><a href={withBase('/steuerkanzlei/')}>Für Steuerkanzleien</a></li>
        <li><a href={withBase('/preise/')}>Preise</a></li>
      </ul>
    </aside>
  </div>
</Base>
