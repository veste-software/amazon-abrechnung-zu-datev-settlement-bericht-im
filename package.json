{
  "name": "amazon-abrechnung-zu-datev",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "astro check && astro build",
    "build:preview": "SITE_URL=https://example.github.io SITE_BASE=/preview astro build",
