---
import Base from '../layouts/Base.astro';
---

<Base title="Impressum – Abrechnung → DATEV" description="Impressum und Anbieterkennzeichnung.">
  <p class="section-label">Entwurf · rechtlich prüfen lassen</p>
  <h1>Impressum</h1>
  <p class="notice notice-warn">
    <span class="label">Entwurf</span>Platzhalter. Die Angaben nach § 5 DDG trägt der Betreiber ein; der Text wird anwaltlich geprüft.
  </p>
  <h2>Angaben nach § 5 DDG</h2>
  <p>[Name / Firma]<br />[Straße Hausnummer]<br />[PLZ Ort]<br />Deutschland</p>
  <h2>Kontakt</h2>
  <p>E-Mail: [Adresse]</p>
  <h2>Umsatzsteuer-ID</h2>
  <p>[USt-IdNr. nach § 27a UStG]</p>
  <h2>Verantwortlich für den Inhalt</h2>
  <p>[Name, Anschrift]</p>
</Base>
